                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"data\":[{\"id\":\"00000000-0000-4000-8000-000000000001\",\"source\":\"naturalis\",\"external_id\":\"NAT-00001\",\"scientific_name\":\"Ammonite example\",\"geological_context\":\"Cretaceous\",\"latitude\":52.1,\"longitude\":5.1},{\"id\":\"00000000-0000-4000-8000-000000000002\",\"source\":\"naturalis\",\"external_id\":\"NAT-00002\",\"scientific_name\":\"Ammonite example\",\"geological_context\":\"Cretaceous\",\"latitude\":52.1,\"longitude\":5.1}],\"meta\":{\"pagination\":{\"total\":2,\"count\":2,\"per_page\":15,\"current_page\":1,\"total_pages\":1,\"links\":{}}}}",
