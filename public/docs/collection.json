                                    "description": "Filter by a scientific name containing this text.",
                                    "disabled": false
                                },
                                {
                                    "key": "per_page",
                                    "value": "25",
                                    "description": "Number of records per page (1-100). Defaults to 15.",
                                    "disabled": false
                                }
